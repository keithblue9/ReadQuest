# Konfigurasi stack production (deploy/docker-compose.yml).
# Salin ke deploy/.env lalu isi. JANGAN commit deploy/.env (sudah di .gitignore).

# Domain publik (DNS A/AAAA harus mengarah ke server) & email untuk sertifikat Let's Encrypt.
DOMAIN=baca.example.com
ACME_EMAIL=admin@example.com

# Tag image hasil build (opsional).
TAG=latest

# Secret JWT, min. 32 karakter. Buat dengan: openssl rand -base64 48
JWT_SECRET=

# Object storage (RustFS di compose ini). Secret min. 8 karakter: openssl rand -base64 24
S3_ACCESS_KEY=readquest
S3_SECRET_KEY=
S3_BUCKET=readquest-photos

# Web Push (opsional). Buat sekali setelah image backend di-build:
#   docker compose build backend && docker run --rm readquest-backend python -m app.scripts.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Seed awal: admin pertama & kode undangan tim (dipakai oleh layanan `seed`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin
SEED_INVITE_CODE=
