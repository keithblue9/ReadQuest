# Salin ke frontend/.env.local lalu isi.

# Server-side: alamat FastAPI yang menjadi tujuan proxy /api/* (tidak terlihat di browser).
API_PROXY_TARGET=http://localhost:8000

# Kunci publik VAPID tidak perlu diisi di sini: frontend mengambilnya dari GET /api/v1/push/config.
# Variabel NEXT_PUBLIC_* (bila kelak dipakai) terlihat di browser — jangan taruh secret di sini.
