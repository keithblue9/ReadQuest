# Salin ke frontend/.env.local lalu isi.

# Server-side: alamat FastAPI yang menjadi tujuan proxy /api/* (tidak terlihat di browser).
API_PROXY_TARGET=http://localhost:8000

# Variabel NEXT_PUBLIC_* terlihat di browser — jangan taruh secret di sini.
# Kunci publik VAPID untuk Web Push (Fase 8).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
