# Salin ke backend/.env lalu isi. JANGAN commit file .env.

# App
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB (replica set lokal dari docker-compose)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=readquest

# JWT
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Object storage (S3-compatible; MinIO lokal)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=readquest
S3_SECRET_KEY=change-me-min-8-chars
S3_BUCKET=readquest-photos

# Web Push (VAPID) — buat pasangan kunci sendiri, jangan commit private key
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# SSO OIDC (opsional)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
