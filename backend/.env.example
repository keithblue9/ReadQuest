# Salin ke backend/.env lalu isi. JANGAN commit file .env.

# App: development | test | production
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB (replica set lokal dari docker-compose)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=readquest

# JWT — buat dengan: openssl rand -hex 32  (wajib >= 32 karakter di production)
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Cookie refresh token: wajib true di production (HTTPS)
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# Seed (python -m app.seed): admin pertama, login dengan nomor HP + PIN 6 angka.
# ADMIN_EMAIL opsional: isi bila ingin akun admin lama (login email) diberi nomor HP & PIN.
ADMIN_PHONE=
ADMIN_PIN=
ADMIN_NAME=Admin
ADMIN_EMAIL=

# Penyimpanan foto: "s3" (RustFS lokal dari docker-compose / S3 / R2), "mongo" (di MongoDB,
# untuk Render), atau "local" (folder)
STORAGE_BACKEND=s3
# true = jalankan seed idempoten saat backend start (host tanpa pre-deploy command, mis. Render Free)
SEED_ON_STARTUP=false
LOCAL_STORAGE_DIR=./.storage
# Kredensial sama dengan S3_ACCESS_KEY/S3_SECRET_KEY di .env root (docker-compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=readquest
S3_SECRET_KEY=change-me-min-8-chars
S3_BUCKET=readquest-photos

# Web Push (VAPID). Buat dengan: uv run python -m app.scripts.generate_vapid
# Jangan commit private key. Kosong = push nonaktif (lonceng in-app tetap jalan).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Scheduler notifikasi di dalam proses API
SCHEDULER_ENABLED=true

# SSO OIDC (opsional, fase terpisah)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
